{
  "manifest_version": 3,
  "name": "Ultimate Guitar Zombie",
  "version": "1.0.0",
  "description": "Keeps your screen awake while Ultimate Guitar autoscroll is running on the focused page.",
  "key": "",
  "permissions": [
    "power",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ultimate Guitar Zombie",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/ug.png"
    }
  },
  "icons": {
    "32": "icons/ug.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ultimate-guitar.com/*"
      ],
      "js": [
        "detector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
