{
  "manifest_version": 3,
  "name": "Ultimate Guitar Zombie",
  "version": "1.1.1",
  "description": "Keeps focused Ultimate Guitar tab pages awake, with a five-minute idle timeout unless autoscroll is running.",
  "key": "",
  "permissions": [
    "power",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ultimate Guitar Zombie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/ug-16.png",
      "32": "icons/ug.png",
      "48": "icons/ug-48.png"
    }
  },
  "icons": {
    "16": "icons/ug-16.png",
    "32": "icons/ug.png",
    "48": "icons/ug-48.png",
    "128": "icons/ug-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ultimate-guitar.com/*"
      ],
      "js": [
        "detector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
